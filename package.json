{
  "name": "@sort/monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:api": "pnpm run --filter @sort/api dev",
    "dev:worker": "pnpm run --filter @sort/worker dev",
    "dev:web": "pnpm run --filter @sort/web dev",
    "prepare": "husky",
    "db:reset": "pnpm run --filter @sort/api db:reset",
    "db:codegen": "pnpm run --filter @sort/shared db:codegen",
    "lint:fix": "pnpm run -r lint:fix",
    "madge": "pnpm run -r madge",
    "test": "pnpm run --filter !@sort/api --filter !@sort/shared -r test && pnpm run --filter @sort/api --filter @sort/shared test:all",
    "test-worker": "pnpm run --filter @sort/worker test",
    "test-api": "pnpm run --filter @sort/api test:all",
    "infra:up": "pnpm run --filter @sort/api infra:up",
    "infra:down": "pnpm run --filter @sort/api infra:down",
    "reset": "rm -rf ./node_modules && pnpm -r exec rm -rf node_modules dist .eslintcache tsconfig.tsbuildinfo"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "syncpack": "^13.0.2"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}
