{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "lib": ["ESNext"],
    "target": "ES2022",
    "sourceMap": true,
    "inlineSources": true,
    "noErrorTruncation": true
  }
}
