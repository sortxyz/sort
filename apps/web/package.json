  "scripts": {
    "build": "NODE_ENV=production react-router build",
    "build-storybook": "storybook build",
    "check": "pnpm run --stream '/.*:check$/'",
    "clean": "scripts/clean.sh",
    "codegen:playwright": "playwright codegen http://localhost:3000 --load-storage=playwright/.auth/test-user-chromium.json",
    "coverage:test:storybook": "test-storybook --coverage",
    "dev": "pnpm run --stream '/^dev:.*$/'",
    "dev:app": "react-router dev",
    "dev:packages": "pnpm run -rp dev",
    "format": "prettier --write --cache --cache-location .prettiercache .",
    "format:check": "prettier --check --cache --cache-location .prettiercache .",
    "lint": "eslint --fix --cache --cache-location .eslintcache .",
    "lint:check": "eslint --cache --cache-location .eslintcache .",
    "prepare": "husky",
    "pull:env": "vercel env pull .env.local",
    "routes": "react-router routes",
    "start": "react-router-serve ./build/server/nodejs-eyJtYXhEdXJhdGlvbiI6NjAsInJ1bnRpbWUiOiJub2RlanMifQ/index.js",
    "start:dev": "env $(cat .env.local | grep -v \"#\" | xargs) pnpm start",
    "storybook": "storybook dev -p 6006",
    "storybook:dev": "BROWSER=none storybook dev -p 6006",
    "storybook:test": "wait-on tcp:6006 && test-storybook",
    "test": "pnpm run -w --stream '/test:(unit|e2e)$/'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "pnpm test:e2e --ui",
    "test:storybook": "pnpm run --stream '/storybook:(dev|test)$/'",
    "test:unit": "vitest",
    "type:check": "react-router typegen && tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module"
