{
  "bugs": {
    "url": "https://github.com/sortxyz/sort-api-v2/issues"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/type-provider-typebox": "^4.1.0",
    "@scalar/fastify-api-reference": "^1.25.116",
    "@sentry/node": "^8.54.0",
    "@sinclair/typebox": "^0.33.11",
    "@sort/config": "workspace:*",
    "@sort/logger": "workspace:*",
    "@sort/shared": "workspace:*",
    "@sort/shutdown": "workspace:*",
    "@tediousjs/connection-string": "^0.5.0",
    "dotenv": "^16.4.7",
    "fast-jwt": "^5.0.5",
    "fastify": "^4.28.1",
    "form-data": "^4.0.1",
    "friendly-username-generator": "^2.0.4",
    "generic-pool": "^3.9.0",
    "get-jwks": "^11.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "kysely": "^0.27.5",
    "mailgun.js": "^11.1.0",
    "markdown-it": "^14.1.0",
    "pg": "^8.13.1",
    "pg-types": "^4.0.1",
    "pgsql-ast-parser": "^12.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "snowflake-sdk": "^2.0.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@quobix/vacuum": "^0.16.2",
    "@types/cookie-signature": "^1.1.0",
    "@types/jest": "^29.5.14",
    "@types/json2csv": "^5.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/snowflake-sdk": "^1.6.24",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.2.5",
    "madge": "^8.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.0.0",
    "ts-jest": "~29.1.0",
    "typescript": "~5.5.0"
  },
  "homepage": "https://github.com/sortxyz/sort-api-v2#readme",
  "license": "ISC",
  "name": "sort-api-v2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sortxyz/sort-api-v2.git"
  },
  "scripts": {
    "prepare": "tsc && mkdir -p dist/docs/descriptions && cp src/docs/descriptions/*.md dist/docs/descriptions",
    "copy-mailgun-template": "pnpm exec tsx src/scripts/copy-mailgun-template.ts",
    "db:create-test-user": "pnpm exec tsx src/scripts/create-test-user.ts",
    "db:reset": "pnpm infra:down && pnpm infra:up && pnpm db:create-test-user",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d",
    "lint:fix": "eslint . --ext .js,.ts --fix --cache",
    "lint": "eslint . --ext .js,.ts --cache",
    "madge": "pnpm exec madge --circular src/index.ts ../../packages/",
    "madge:img": "pnpm exec madge --circular --image api-circular.svg src/index.ts ../../packages/",
    "open:cov": "open ./src/coverage/lcov-report/index.html",
    "open:openapi:report": "open ./openapi/report.html",
    "open:openapi:spec": "open ./openapi/spec.json",
    "dev": "nodemon | pino-pretty",
    "start": "node ./dist/index.js",
    "test:all": "pnpm madge && NODE_ENV=test bin/test && pnpm test:openapi:lint",
    "test:cov": "pnpm lint:fix && NODE_ENV=test jest --config ./jest.config.ts --detectOpenHandles --coverage && pnpm test:openapi:lint",
    "test:watch": "NODE_ENV=test jest --config ./jest.config.ts --detectOpenHandles --watch",
    "test:changed": "pnpm lint:fix && NODE_ENV=test jest -o --config ./jest.config.ts --detectOpenHandles",
    "test:openapi": "NODE_ENV=test pnpm exec tsx src/scripts/create-openapi-spec.ts && pnpm exec vacuum html-report ./openapi/spec.json openapi/report.html",
    "test:openapi:report": "NODE_ENV=test pnpm exec tsx src/scripts/create-openapi-spec.ts && pnpm exec vacuum html-report ./openapi/spec.json openapi/report.html && open openapi/report.html",
    "test:openapi:lint": "NODE_ENV=test pnpm exec tsx src/scripts/create-openapi-spec.ts && pnpm exec vacuum lint ./openapi/spec.json -b -e -d -q || { echo '\nFor more info about the errors:  pnpm test:openapi:report' && exit 1; }",
    "jest": "NODE_ENV=test jest --config ./jest.config.ts --detectOpenHandles",
    "test": "NODE_ENV=test pnpm lint:fix && pnpm jest && pnpm test:openapi:lint"
  },
  "version": "2.0.301"
}
